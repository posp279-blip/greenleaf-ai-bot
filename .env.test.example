# Greenleaf AI Bot v2 — isolated test environment
# Copy values into Replit Secrets. Never commit real secrets.

NODE_ENV=production
PORT=3000

# Use a separate empty PostgreSQL database for testing.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Token of a NEW Telegram bot created only for testing.
TELEGRAM_BOT_TOKEN=0000000000:TEST_TOKEN_FROM_BOTFATHER

# Proxy API
AI_ENABLED=true
PROXY_API_KEY=TEST_PROXY_API_KEY
PROXY_API_BASE_URL=https://api.proxyapi.ru/openai/v1
PROXY_API_MODEL=gpt-4o-mini
PROXY_API_TIMEOUT_MS=15000
PROXY_API_HEALTH_CACHE_MS=60000

# Web admin
ADMIN_PASSWORD=CREATE_A_SEPARATE_TEST_PASSWORD
SESSION_SECRET=CREATE_A_LONG_RANDOM_TEST_SECRET
ADMIN_TELEGRAM_IDS=YOUR_TELEGRAM_NUMERIC_ID

# Telegram reliability
TELEGRAM_UPDATE_DEDUP_TTL_MS=600000
TELEGRAM_USER_MIN_INTERVAL_MS=500

# Do not copy the production REPLIT_APP_URL.
# The test Replit must use its own generated domain.
