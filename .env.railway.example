# Railway injects PORT and RAILWAY_PUBLIC_DOMAIN automatically.
NODE_ENV=production

# Set this as a reference to the PostgreSQL service:
# ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_UPDATE_DEDUP_TTL_MS=600000
TELEGRAM_USER_MIN_INTERVAL_MS=500

# VK community bot
VK_GROUP_TOKEN=
VK_GROUP_ID=
VK_GROUP_SCREEN_NAME=
VK_CALLBACK_SECRET=
VK_CONFIRMATION_CODE=
VK_API_VERSION=5.199
VK_EVENT_DEDUP_TTL_MS=600000
VK_USER_MIN_INTERVAL_MS=500

# Administration
ADMIN_PASSWORD=
SESSION_SECRET=
ADMIN_TELEGRAM_IDS=

# Proxy API
PROXY_API_KEY=
PROXY_API_BASE_URL=https://api.proxyapi.ru/openai/v1
PROXY_API_MODEL=gpt-4o-mini

# Optional override. Leave empty on Railway to use RAILWAY_PUBLIC_DOMAIN.
PUBLIC_APP_URL=
